# --- Clinical Scribe Frontend ---------------------------------------------
# Copy to .env.local and fill in. NEXT_PUBLIC_* values are shipped to the
# browser — only the anon key ever goes here, never the service-role key.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# FastAPI backend base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Web Push public key — must match the backend's VAPID_PUBLIC_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
