# --- Aura Frontend ---------------------------------------------------------
# Copy to .env.local and fill in. NEXT_PUBLIC_* values are shipped to the
# browser — only the anon key ever goes here, never the service-role key.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# FastAPI backend base URL. No trailing slash.
#
# IMPORTANT: this value is baked into the Content-Security-Policy connect-src
# at BUILD time (see next.config.ts). Changing it requires a rebuild — a stale
# value makes the browser block every backend call, and the app then reports
# itself as down for maintenance while the backend is perfectly healthy.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Web Push public key. Must EXACTLY equal VAPID_PUBLIC_KEY in backend/.env;
# if they differ, subscriptions are created against a key the backend cannot
# sign for and notifications fail silently.
# Generate with: python backend/scripts/generate_vapid_keys.py
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
