# --- Aura Backend ----------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env.

# Supabase project (Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key: server-side ONLY. Grants RLS-bypassing writes so the
# backend can manage the ephemeral transcript lifecycle. Keep out of the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT secret (Settings → API → JWT Settings) used to verify user access tokens.
SUPABASE_JWT_SECRET=your-jwt-secret

# CORS: comma-separated origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000

# "development" | "production". Set to "production" when deploying to disable
# the interactive API docs (/docs, /redoc, /openapi.json).
ENVIRONMENT=development

# Whisper speech-to-text (faster-whisper). large-v3 = max accuracy;
# int8 keeps it CPU-friendly. Weights (~1.5 GB) download + cache on first use.
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=int8

# Local embedding model for the patient-memory index (768-dim — must match
# the vector(768) schema from migration 0005).
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Directory for transient audio files during inference. Contents are purged
# after every job; point this at fast local disk, never a shared volume.
AUDIO_SCRATCH_DIR=/tmp/clinical-scribe-audio

# Hard cap on uploaded audio size (bytes). 100 MiB default.
MAX_AUDIO_BYTES=104857600

# Web Push (VAPID) for appointment reminders. Generate a keypair (P-256, raw
# base64url) and keep the private key secret. The public key must also be set
# as NEXT_PUBLIC_VAPID_PUBLIC_KEY in the frontend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
