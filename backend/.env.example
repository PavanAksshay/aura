# --- Aura Backend ----------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env.
#
# Every setting in app/core/config.py has an entry here. A missing entry does
# not fail loudly — it silently falls back to the default, which is how push
# notifications ended up disabled in production once.

# --- Supabase (Settings → API) ---------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key: server-side ONLY. Grants RLS-bypassing writes so the
# backend can manage the ephemeral transcript lifecycle. Keep out of the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT secret (Settings → API → JWT Settings) used to verify user access tokens.
SUPABASE_JWT_SECRET=your-jwt-secret

# --- HTTP ------------------------------------------------------------------
# Comma-separated origins allowed to call this API. NO trailing slashes —
# origins are matched exactly against the browser's Origin header, which never
# has one. Must include every deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:3000

# "development" | "production". Production disables /docs, /redoc, /openapi.json.
ENVIRONMENT=development

# --- Capacity --------------------------------------------------------------
# How many transcription pipelines may run at once. Each holds a Whisper model,
# a pyannote pass and an Ollama call on ONE machine, so this is a physical
# limit, not a throughput knob: measured at 4.2x realtime idle and 8.5x under
# light contention, raising it makes every job slower rather than finishing
# more. Extra uploads queue.
MAX_CONCURRENT_TRANSCRIPTIONS=1

# --- Transcription (faster-whisper, fully local) ----------------------------
# large-v3 = maximum accuracy; int8 keeps it runnable on CPU. Weights (~1.5 GB)
# download and cache on first use.
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=int8

# --- Speaker diarization (pyannote.audio) -----------------------------------
# Optional. The pyannote models are gated on Hugging Face: HF_TOKEN must belong
# to an account that has accepted the conditions for both the diarization and
# segmentation models. Without a valid token the pipeline degrades to a plain
# unlabelled transcript rather than failing.
ENABLE_DIARIZATION=true
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
HF_TOKEN=
# Label the first voice "Therapist" and the rest "Patient"/"Patient 2".
# Set false for neutral "Speaker N" labels.
LABEL_SPEAKER_ROLES=true

# --- Patient-memory embeddings (fastembed/ONNX, in-process) -----------------
# 768-dim — must match the vector(768) columns from migration 0005.
# CHANGING THIS INVALIDATES EVERY STORED VECTOR — re-index all notes after.
# NOTE: uvicorn --reload watches .py files, NOT .env. Restart properly after
# changing this or the server keeps serving the old model against new vectors.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# --- Local LLM (Ollama) -----------------------------------------------------
# Drafts the session note and summaries. If unreachable, both fall back to a
# deterministic heuristic rather than failing.
OLLAMA_URL=http://localhost:11434
SUMMARY_MODEL=llama3.2:3b

# --- AI usage quota -------------------------------------------------------
# Every Ollama call runs on the machine hosting this backend, so guests get a
# daily allowance and the operator does not. OWNER_EMAIL is matched against the
# JWT-verified email claim — it cannot be spoofed from the client. When a guest
# hits the limit they are told to contact this address.
# Set AI_DAILY_LIMIT=0 to disable the quota entirely.
OWNER_EMAIL=
AI_DAILY_LIMIT=25

# --- Web Push (VAPID) -------------------------------------------------------
# Appointment reminders that arrive with the app closed. BOTH keys must be set
# or the reminder scheduler becomes a silent no-op.
# VAPID_PUBLIC_KEY must exactly equal NEXT_PUBLIC_VAPID_PUBLIC_KEY in the
# frontend, or the browser subscribes against a key the backend cannot sign for.
# Generate a P-256 keypair (raw base64url) — see scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# How far ahead of an appointment to push, and how often to look for due ones.
REMINDER_LEAD_MINUTES=10
REMINDER_POLL_SECONDS=60

# --- Audio handling ---------------------------------------------------------
# Transient audio during inference. Purged after every job; point at fast local
# disk, never a shared volume.
AUDIO_SCRATCH_DIR=/tmp/clinical-scribe-audio
# Hard cap on uploaded audio size (bytes). 100 MiB default.
MAX_AUDIO_BYTES=104857600
